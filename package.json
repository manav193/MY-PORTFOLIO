{
  "name": "portfolio",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node build.js && node qa-postbuild.js",
    "build:root": "node build.js --base / && node qa-postbuild.js",
    "build:subdir": "node build.js --base /portfolio/ && node qa-postbuild.js",
    "preview": "npx vite preview --port 4173",
    "verify": "playwright test tests/global-shell-regression.spec.js",
    "test:arcade": "playwright test tests/arcade-regression.spec.js",
    "test:experience": "playwright test tests/experience-audio.spec.js",
    "test:developer": "playwright test tests/developer-mode.spec.js",
    "test:production": "playwright test tests/final-production-qa.spec.js --config=playwright.production.config.js",
    "qa:links": "node scripts/link-checker.mjs",
    "qa:budget": "node scripts/performance-budget.mjs",
    "qa:dom": "node scripts/verify-dom-contracts.mjs",
    "qa:deployment": "node scripts/check-latest-deployment.mjs",
    "qa:engineering": "playwright test tests/engineering-qa.spec.js",
    "qa:all": "npm run build && npm run qa:dom && npm run qa:links && npm run qa:budget && npm run qa:engineering"
  },
  "dependencies": {
    "clean-css": "^5.3.3",
    "esbuild": "^0.28.1",
    "html-minifier-terser": "^7.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}